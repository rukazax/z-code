{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/assets/hook-check.ps1"
            ],
            "timeoutMs": 20000,
            "statusMessage": "zcode-ru: проверка локализации"
          }
        ]
      }
    ]
  }
}
